{
  "$id": "question_manifest.schema.json",
  "title": "Bounded question orchestration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "question_id", "question_sha256", "created_at", "updated_at",
    "state", "mode", "max_subtasks", "selected_roles", "subtasks", "paths"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "question_id": {"type": "string", "pattern": "^q-[0-9a-f]{16}$"},
    "question_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "state": {
      "enum": ["initialized", "planned", "assigned", "collecting", "ready_for_synthesis", "synthesized", "delivered", "blocked"]
    },
    "mode": {"type": ["string", "null"], "enum": [null, "symptom", "treatment", "sparse-context", "bounded-artifact", "quantitative-data"]},
    "max_subtasks": {"type": "integer", "minimum": 1, "maximum": 5},
    "selected_roles": {
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "items": {"enum": ["context-evidence", "clinical-options-uncertainty", "safety-urgency", "constraints-artifact", "quantitative-data"]}
    },
    "subtasks": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "status", "assignment_sha256", "result_sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$"},
          "role": {"type": "string"},
          "status": {"enum": ["planned", "assigned", "complete", "blocked"]},
          "assignment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "paths": {
      "type": "object", "additionalProperties": false,
      "required": ["question", "subtasks", "decision", "final", "validation"],
      "properties": {
        "question": {"const": "question.txt"},
        "subtasks": {"const": "subtasks"},
        "decision": {"const": "synthesis/decision.json"},
        "final": {"const": "final.txt"},
        "validation": {"const": "validation.json"}
      }
    }
  }
}
